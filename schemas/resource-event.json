{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resource-monitor.example/schemas/resource-event.json",
  "title": "Resource Monitor event",
  "type": "object",
  "required": ["event_id", "schema_version", "event_type", "subject_id", "occurred_at", "source_id", "severity", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "source_id": {"type": "string", "minLength": 1},
    "severity": {"type": "string", "enum": ["debug", "info", "warning", "error", "critical"]},
    "payload": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
